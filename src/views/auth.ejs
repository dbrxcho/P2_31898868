<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/styles.css">
  <title>Autenticación</title>
  <link rel="stylesheet" href="/css/auth.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="js/alertConfig.js"></script>
  <style>
    .google-btn {
      display: inline-flex;
      align-items: center;
      padding: 10px 15px;
      background: white;
      color: #444;
      border: 1px solid #ddd;
      border-radius: 4px;
      text-decoration: none;
    }

    .google-btn img {
      width: 20px;
      margin-right: 10px;
    }
  </style>
</head>
<body>
  <!-- NAVBAR -->
<nav class="w-full bg-gradient-to-r from-gray-900 via-gray-800 to-black text-white fixed top-0 z-50 shadow-2xl backdrop-blur-sm border-b border-gray-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-20">

    <!-- Logo -->
    <a href="#Inicio" class="flex items-center gap-3 hover:scale-105 transition-transform duration-300">
      <img src="../imagenes/brachofit.png" alt="BrachoFIT Logo" class="h-12 w-auto filter brightness-110">
      <span class="font-bold text-2xl bg-gradient-to-r from-orange-400 to-red-500 bg-clip-text text-transparent">
        BrachoFIT
      </span>
    </a>

    <!-- Mobile menu button -->
    <button id="nav-toggle" class="md:hidden text-2xl focus:outline-none hover:text-orange-400 transition-colors">
      <i class="fas fa-bars"></i>
    </button>

    <!-- Desktop Menu -->
    <ul id="nav-menu" class="hidden md:flex md:items-center md:space-x-8 font-medium">
      <% if(view !== 'index'){ %>
      <li>
        <a href="/" class="hover:text-orange-400 transition-all duration-300 border-b-2 border-transparent hover:border-orange-400 pb-1">
          <i class="fas fa-home mr-2"></i><%= __('nav.inicio') %>
        </a>
      </li>
      <% } %>
      <li>
        <a href="#servicios" class="hover:text-orange-400 transition-all duration-300 border-b-2 border-transparent hover:border-orange-400 pb-1">
          <i class="fas fa-dumbbell mr-2"></i><%= __('nav.servicios') %>
        </a>
      </li>
      <li>
        <a href="#beneficios" class="hover:text-orange-400 transition-all duration-300 border-b-2 border-transparent hover:border-orange-400 pb-1">
          <i class="fas fa-star mr-2"></i><%= __('nav.beneficios') %>
        </a>
      </li>
      <li>
        <a href="/entrenamiento" class="hover:text-orange-400 transition-all duration-300 border-b-2 border-transparent hover:border-orange-400 pb-1">
          <i class="fas fa-user-friends mr-2"></i><%= __('nav.entrenamiento') %>
        </a>
      </li>
      <li>
        <a href="/getPayment" class="hover:text-orange-400 transition-all duration-300 border-b-2 border-transparent hover:border-orange-400 pb-1">
          <i class="fas fa-credit-card mr-2"></i><%= __('nav.pagos') %>
        </a>
      </li>
      <li>
        <a href="/admin/contacts" class="hover:text-orange-400 transition-all duration-300 border-b-2 border-transparent hover:border-orange-400 pb-1">
          <i class="fas fa-envelope mr-2"></i><%= __('nav.contacto') %>
        </a>
      </li>
      <li>
        <a href="/login?form=login" class="bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 px-4 py-2 rounded-full flex items-center gap-2 transition-all duration-300 transform hover:scale-105 shadow-lg">
          <i class="fas fa-sign-in-alt"></i><%= __('nav.login') %>
        </a>
      </li>
      <% if (isAdmin) { %>
      <li>
        <a href="/logout" class="bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 px-4 py-2 rounded-full flex items-center gap-2 transition-all duration-300 transform hover:scale-105 shadow-lg">
          <i class="fas fa-sign-out-alt"></i><%= __('nav.logout') %>
        </a>
      </li>
      <% } %>

      <!-- Language Dropdown -->
      <li class="relative group">
        <button class="flex items-center gap-2 hover:text-orange-400 transition-all duration-300 px-3 py-2 rounded-lg hover:bg-gray-800">
          <i class="fas fa-globe text-lg"></i>
          <span class="font-medium"><%= __('nav.idioma') %></span>
          <i class="fas fa-chevron-down text-xs transition-transform duration-200 group-hover:rotate-180"></i>
        </button>
        <ul class="absolute right-0 mt-2 bg-gray-800 text-white rounded-lg shadow-2xl overflow-hidden opacity-0 group-hover:opacity-100 scale-95 group-hover:scale-100 transition-all duration-200 transform origin-top min-w-[140px] z-50 border border-gray-700">
          <li>
            <a href="/login?form=<%= formType %>&lang=es" class="block px-4 py-3 hover:bg-gradient-to-r hover:from-orange-500 hover:to-red-500 transition-all duration-200 flex items-center gap-2">
              <span class="text-lg">🇪🇸</span>
              <span class="font-medium">Español</span>
            </a>
          </li>
          <li>
            <a href="/login?form=<%= formType %>&lang=en" class="block px-4 py-3 hover:bg-gradient-to-r hover:from-orange-500 hover:to-red-500 transition-all duration-200 flex items-center gap-2">
              <span class="text-lg">🇺🇸</span>
              <span class="font-medium">English</span>
            </a>
          </li>
        </ul>
      </li>
    </ul>
  </div>

  <!-- Mobile Dropdown Menu -->
  <ul id="nav-mobile" class="md:hidden hidden flex-col bg-gradient-to-b from-gray-900 to-black text-white space-y-1 py-4 px-6 shadow-inner">
    <% if(view !== 'index'){ %>
    <li>
      <a href="/" class="block py-3 px-4 hover:bg-gray-800 rounded-lg transition-all duration-200 flex items-center gap-3">
        <i class="fas fa-home text-orange-400"></i>
        <span><%= __('nav.inicio') %></span>
      </a>
    </li>
    <% } %>
    <li>
      <a href="#servicios" class="block py-3 px-4 hover:bg-gray-800 rounded-lg transition-all duration-200 flex items-center gap-3">
        <i class="fas fa-dumbbell text-orange-400"></i>
        <span><%= __('nav.servicios') %></span>
      </a>
    </li>
    <li>
      <a href="#beneficios" class="block py-3 px-4 hover:bg-gray-800 rounded-lg transition-all duration-200 flex items-center gap-3">
        <i class="fas fa-star text-orange-400"></i>
        <span><%= __('nav.beneficios') %></span>
      </a>
    </li>
    <li>
      <a href="/entrenamiento" class="block py-3 px-4 hover:bg-gray-800 rounded-lg transition-all duration-200 flex items-center gap-3">
        <i class="fas fa-user-friends text-orange-400"></i>
        <span><%= __('nav.entrenamiento') %></span>
      </a>
    </li>
    <li>
      <a href="/getPayment" class="block py-3 px-4 hover:bg-gray-800 rounded-lg transition-all duration-200 flex items-center gap-3">
        <i class="fas fa-credit-card text-orange-400"></i>
        <span><%= __('nav.pagos') %></span>
      </a>
    </li>
    <li>
      <a href="#contacto" class="block py-3 px-4 hover:bg-gray-800 rounded-lg transition-all duration-200 flex items-center gap-3">
        <i class="fas fa-envelope text-orange-400"></i>
        <span><%= __('nav.contacto') %></span>
      </a>
    </li>
    <li>
      <a href="/login?form=login" class="block py-3 px-4 bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 rounded-lg transition-all duration-200 flex items-center gap-3 mt-2">
        <i class="fas fa-sign-in-alt"></i>
        <span><%= __('nav.login') %></span>
      </a>
    </li>
    <% if (isAdmin) { %>
    <li>
      <a href="/logout" class="block py-3 px-4 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 rounded-lg transition-all duration-200 flex items-center gap-3">
        <i class="fas fa-sign-out-alt"></i>
        <span><%= __('nav.logout') %></span>
      </a>
    </li>
    <% } %>
    
    <!-- Language toggle mobile -->
    <li class="border-t border-gray-700 pt-4 mt-4">
      <p class="text-sm text-gray-400 mb-3 px-4"><%= __('nav.idioma') %>:</p>
      <div class="flex gap-2 px-4">
        <a href="/login?form=<%= formType %>&lang=es" class="flex-1 py-2 px-3 bg-gray-800 hover:bg-gradient-to-r hover:from-orange-500 hover:to-red-500 rounded-lg transition-all duration-200 flex items-center justify-center gap-2">
          <span>🇪🇸</span>
          <span class="text-sm">Español</span>
        </a>
        <a href="/login?form=<%= formType %>&lang=en" class="flex-1 py-2 px-3 bg-gray-800 hover:bg-gradient-to-r hover:from-orange-500 hover:to-red-500 rounded-lg transition-all duration-200 flex items-center justify-center gap-2">
          <span>🇺🇸</span>
          <span class="text-sm">English</span>
        </a>
      </div>
    </li>
  </ul>
</nav>
  <div class="mt-20 min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-black flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <!-- Auth Container -->
    <div class="bg-gray-800/50 backdrop-blur-sm border border-gray-700 rounded-xl shadow-2xl p-8">
      
      <!-- Auth Switcher -->
      <div class="flex bg-gray-700/50 rounded-lg p-1 mb-8">
        <button 
          class="flex-1 py-2 px-4 text-sm font-medium rounded-md transition-all duration-200 <%= formType === 'login' ? 'bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg' : 'text-gray-300 hover:text-white hover:bg-gray-600/50' %>" 
          onclick="switchForm('login')"
        >
          <%= __('auth.login_button') %>
        </button>
        <button 
          class="flex-1 py-2 px-4 text-sm font-medium rounded-md transition-all duration-200 <%= formType === 'register' ? 'bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg' : 'text-gray-300 hover:text-white hover:bg-gray-600/50' %>" 
          onclick="switchForm('register')"
        >
          <%= __('auth.register_button') %>
        </button>
      </div>

      <% if (formType === 'login') { %>
        <!-- Login Form -->
        <form id="formLogin" class="space-y-6">
          <div class="text-center">
            <h2 class="text-2xl font-bold text-white mb-2"><%= __('auth.login_title') %></h2>
            <p class="text-gray-400 text-sm"><%= __('auth.login_subtitle') %></p>
          </div>
          
          <div class="space-y-4">
            <div>
              <label for="login-email" class="block text-sm font-medium text-gray-300 mb-2">
                <%= __('auth.email_label') %>
              </label>
              <input 
                type="email" 
                id="login-email" 
                name="email" 
                required
                placeholder="<%= __('auth.email_placeholder') %>"
                class="w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
            </div>
            
            <div>
              <label for="login-password" class="block text-sm font-medium text-gray-300 mb-2">
                <%= __('auth.password_label') %>
              </label>
              <input 
                type="password" 
                id="login-password" 
                name="password" 
                required
                placeholder="<%= __('auth.password_placeholder') %>"
                class="w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
            </div>
          </div>

          <!-- Google Auth Button -->
          <a href="/auth/google" class="w-full flex items-center justify-center px-4 py-3 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-lg hover:shadow-xl">
            <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
              <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            <%= __('auth.google_login') %>
          </a>

          <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-medium rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl transform hover:scale-105">
            <%= __('auth.login_submit') %>
          </button>
        </form>

      <% } else { %>
        <!-- Register Form -->
        <form id="formRegister" class="space-y-6">
          <div class="text-center">
            <h2 class="text-2xl font-bold text-white mb-2"><%= __('auth.register_title') %></h2>
            <p class="text-gray-400 text-sm"><%= __('auth.register_subtitle') %></p>
          </div>
          
          <div class="space-y-4">
            <div>
              <label for="register-name" class="block text-sm font-medium text-gray-300 mb-2">
                <%= __('auth.name_label') %>
              </label>
              <input 
                type="text" 
                id="username" 
                name="username" 
                required
                placeholder="<%= __('auth.name_placeholder') %>"
                class="w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
            </div>
            
            <div>
              <label for="register-email" class="block text-sm font-medium text-gray-300 mb-2">
                <%= __('auth.email_label') %>
              </label>
              <input 
                type="email" 
                id="register-email" 
                name="email" 
                required
                placeholder="<%= __('auth.email_placeholder') %>"
                class="w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
            </div>
            
            <div>
              <label for="register-password" class="block text-sm font-medium text-gray-300 mb-2">
                <%= __('auth.password_label') %>
              </label>
              <input 
                type="password" 
                id="register-password" 
                name="password_hash" 
                required
                placeholder="<%= __('auth.password_placeholder') %>"
                minlength="6"
                class="w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
            </div>
            
            <div>
              <label for="register-confirm" class="block text-sm font-medium text-gray-300 mb-2">
                <%= __('auth.confirm_password_label') %>
              </label>
              <input 
                type="password" 
                id="register-confirm" 
                name="passwordHash" 
                required
                placeholder="<%= __('auth.confirm_password_placeholder') %>"
                class="w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
            </div>
          </div>

          <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-medium rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl transform hover:scale-105">
            <%= __('auth.register_submit') %>
          </button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<script>
  function switchForm(type) {
    window.location.href = `/login?form=${type}`;
  }
</script>
<script>
  let data,formData
  const formRegister = document.querySelector('#formRegister');
  if (formRegister) {
    formRegister.addEventListener('submit', e => {
      e.preventDefault();
      formData = new FormData(e.target);
      data = Object.fromEntries(formData.entries());
      fetch('/registerUser', {
        method: 'POST',
        headers: {
          "Content-type": "application/json"
        },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(res => {
        Swal.fire(res.message);
      });
    });
  }
</script>

<script>
  const formLogin = document.querySelector('#formLogin');
  if (formLogin) {
    formLogin.addEventListener('submit', e => {
      e.preventDefault();
      formData = new FormData(e.target);
      data = Object.fromEntries(formData.entries());
      fetch('/loginPost', {
        method: 'POST',
        headers: {
          "Content-type": "application/json"
        },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(res => {
        if (res.status) {
          Swal.fire(res.message).then(() => {
            window.location.href = '/admin/contacts';
          });
        } else {
          Swal.fire(res.message);
        }
      });
    });
  }
</script>
</body>
</html>