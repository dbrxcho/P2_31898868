            <form id="formulario">
                <ul class="form_datos">
                    <h2><%= __('index.contact_form.title') %></h2>
                    <li class="li" >
                    <input class="datos datoss" type="text" id="nombre" placeholder="<%= __('index.contact_form.name_placeholder') %>" required minlength="3" alt="<%= __('index.contact_form.name_alt') %>">
                    </li>
                    <li class="li">
                    <input class="datos datoss" type="email" id="email" placeholder="<%= __('index.contact_form.email_placeholder') %>" required alt="<%= __('index.contact_form.email_alt') %>">
                    </li>
                    
                    <li class="li">
                    <textarea class="datos datoss" id="comentario" placeholder="<%= __('index.contact_form.comment_placeholder') %>" required></textarea>
