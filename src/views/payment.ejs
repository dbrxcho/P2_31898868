<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de Pago</title>
  <link rel="stylesheet" href="/css/payment.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src='/js/alertConfig.js'></script>
</head>
<body>
  <%-include('partials/nav')%>
 <!-- Contenedor general con el gradiente solicitado -->
<div class="mt-20 min-h-screen flex items-center justify-center bg-gradient-to-r from-gray-900 via-gray-800 to-black p-6">
  <!-- Tarjeta -->
  <div class="w-full max-w-lg bg-gray-900/70 backdrop-blur-sm rounded-2xl shadow-2xl border border-gray-700">
    <!-- Encabezado -->
    <div class="text-center px-8 pt-8">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">
        <%= __('paymentForm.title') %>
      </h1>
      <p class="text-gray-300 mb-6">
        <%= __('paymentForm.subtitle') %>
      </p>
    </div>

    <!-- Formulario -->
    <form id="paymentForm" class="px-8 pb-10 space-y-6">
      <!-- Correo -->
      <div>
        <label for="correo" class="block text-sm font-medium text-gray-300 mb-1">
          <%= __('paymentForm.emailLabel') %>
        </label>
        <input
          type="email"
          id="correo"
          name="correo"
          placeholder="<%= __('paymentForm.emailPlaceholder') %>"
          required
          class="w-full rounded-lg bg-gray-800/70 text-white placeholder-gray-500 border border-gray-700
                 focus:ring focus:ring-emerald-600 focus:border-emerald-600
                 py-3 px-4 transition"
        />
      </div>

      <!-- Nombre del titular -->
      <div>
        <label for="nombreTitular" class="block text-sm font-medium text-gray-300 mb-1">
          <%= __('paymentForm.cardholderLabel') %>
        </label>
        <input
          type="text"
          id="nombreTitular"
          name="nombreTitular"
          placeholder="<%= __('paymentForm.cardholderPlaceholder') %>"
          required
          class="w-full rounded-lg bg-gray-800/70 text-white placeholder-gray-500 border border-gray-700
                 focus:ring focus:ring-emerald-600 focus:border-emerald-600
                 py-3 px-4 transition"
        />
      </div>

      <!-- Número de tarjeta -->
      <div>
        <label for="cardNumber" class="block text-sm font-medium text-gray-300 mb-1">
          <%= __('paymentForm.cardNumberLabel') %>
        </label>
        <input
          type="text"
          id="cardNumber"
          name="cardNumber"
          placeholder="<%= __('paymentForm.cardNumberPlaceholder') %>"
          pattern="[0-9\\s]{13,19}"
          required
          class="w-full rounded-lg bg-gray-800/70 text-white placeholder-gray-500 border border-gray-700
                 focus:ring focus:ring-emerald-600 focus:border-emerald-600
                 py-3 px-4 transition"
        />
      </div>

      <!-- Fecha de expiración y CVV -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Expiración -->
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">
            <%= __('paymentForm.expDateLabel') %>
          </label>
          <div class="flex gap-3">
            <!-- Mes -->
            <select
              id="expMonth"
              name="expMonth"
              required
              class="w-1/2 rounded-lg bg-gray-800/70 text-white border border-gray-700
                     focus:ring focus:ring-emerald-600 focus:border-emerald-600
                     py-3 px-4 transition">
              <option value="" disabled selected><%= __('paymentForm.expMonthPlaceholder') %></option>
              <% for (let i = 1; i <= 12; i++) { %>
                <option value="<%= i < 10 ? '0' + i : i %>"><%= i < 10 ? '0' + i : i %></option>
              <% } %>
            </select>

            <!-- Año -->
            <select
              id="expYear"
              name="expYear"
              required
              class="w-1/2 rounded-lg bg-gray-800/70 text-white border border-gray-700
                     focus:ring focus:ring-emerald-600 focus:border-emerald-600
                     py-3 px-4 transition">
              <option value="" disabled selected><%= __('paymentForm.expYearPlaceholder') %></option>
              <% const currentYear = new Date().getFullYear(); %>
              <% for (let i = 0; i < 10; i++) { %>
                <option value="<%= currentYear + i %>"><%= currentYear + i %></option>
              <% } %>
            </select>
          </div>
        </div>

        <!-- CVV -->
        <div>
          <label for="cvv" class="block text-sm font-medium text-gray-300 mb-1">
            <%= __('paymentForm.cvvLabel') %>
          </label>
          <input
            type="text"
            id="cvv"
            name="cvv"
            placeholder="<%= __('paymentForm.cvvPlaceholder') %>"
            pattern="[0-9]{3,4}"
            required
            class="w-full rounded-lg bg-gray-800/70 text-white placeholder-gray-500 border border-gray-700
                   focus:ring focus:ring-emerald-600 focus:border-emerald-600
                   py-3 px-4 transition"
          />
        </div>
      </div>

      <!-- Monto -->
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1">
          <%= __('paymentForm.amountLabel') %>
        </label>
        <div class="flex gap-3">
          <!-- Moneda -->
          <select
            id="currency"
            name="currency"
            required
            class="w-1/3 rounded-lg bg-gray-800/70 text-white border border-gray-700
                   focus:ring focus:ring-emerald-600 focus:border-emerald-600
                   py-3 px-4 transition">
            <option value="USD"><%= __('paymentForm.currencyUSD') %></option>
            <option value="EUR"><%= __('paymentForm.currencyEUR') %></option>
            <option value="GBP"><%= __('paymentForm.currencyGBP') %></option>
            <option value="JPY"><%= __('paymentForm.currencyJPY') %></option>
          </select>

          <!-- Cantidad -->
          <input
            type="number"
            id="amount"
            name="amount"
            placeholder="<%= __('paymentForm.amountPlaceholder') %>"
            min="0"
            step="0.01"
            required
            class="flex-1 rounded-lg bg-gray-800/70 text-white placeholder-gray-500 border border-gray-700
                   focus:ring focus:ring-emerald-600 focus:border-emerald-600
                   py-3 px-4 transition"
          />
        </div>
      </div>

      <!-- Botón -->
      <button
        type="submit"
        class="w-full bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-semibold
               py-3 rounded-lg shadow-lg transition uppercase tracking-wide">
        <%= __('paymentForm.submit') %>
      </button>
    </form>
  </div>
</div>

<!-- SweetAlert y tu script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/fetch2.js"></script>

</body>
</html>